# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: API-Schlüssel für den E-Mail-Versand via Resend (https://resend.com)
# Anfragen werden serverseitig an jugend@djkspvggherten.de gesendet.
RESEND_API_KEY=""

# EMAIL_FROM: Absenderadresse für Resend (z.B. DJK Spvgg Herten <onboarding@resend.dev> oder verifizierte Domain)
EMAIL_FROM="DJK Spvgg Herten <onboarding@resend.dev>"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
